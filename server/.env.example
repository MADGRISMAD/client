# Postgres. Local: createdb empleos
DATABASE_URL=postgres://localhost/empleos
# Obligatorio en producción: openssl rand -hex 32
JWT_SECRET=
PORT=4000
# Origen del frontend (vacío = cualquiera, solo para desarrollo)
CORS_ORIGIN=http://localhost:5173
# IA (opcional: sin llave todo funciona menos la búsqueda semántica y los asistentes)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
